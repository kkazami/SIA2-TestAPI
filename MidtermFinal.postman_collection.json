{
  "info": {
    "name": "Midterm Final API Reference",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Use only after manually applying REMAINING_CODE.md. Fourteen routes; switch roles by sending Login with the desired loginEmail. Not intended to run top-to-bottom with one role."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5156",
      "type": "string"
    },
    {
      "key": "loginEmail",
      "value": "admin@example.com",
      "type": "string"
    },
    {
      "key": "loginPassword",
      "value": "DemoPass123!",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "tutorId",
      "value": "2",
      "type": "string"
    },
    {
      "key": "availabilityId",
      "value": "",
      "type": "string"
    },
    {
      "key": "appointmentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "startTime",
      "value": "",
      "type": "string"
    },
    {
      "key": "endTime",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"startTime\")) { const start = new Date(Date.now() + 86400000); start.setUTCMinutes(0,0,0); pm.collectionVariables.set(\"startTime\", start.toISOString()); pm.collectionVariables.set(\"endTime\", new Date(start.getTime() + 3600000).toISOString()); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Role: Public. Expected 200. Failure: Wrong password: 401. See REMAINING_CODE.md.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const data = pm.response.json(); pm.collectionVariables.set(\"token\", data.token); pm.collectionVariables.set(data.user.role.toLowerCase() + \"Token\", data.token); pm.collectionVariables.set(data.user.role.toLowerCase() + \"Id\", data.user.id); }"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 example",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/v1/auth/login",
                "description": "Role: Public. Expected 200. Failure: Wrong password: 401. See REMAINING_CODE.md.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "auth": {
                  "type": "noauth"
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"message\": \"Login successful.\",\n  \"token\": \"<generated token>\",\n  \"expiresUtc\": \"2026-10-13T02:00:00Z\",\n  \"user\": {\n    \"id\": 1,\n    \"name\": \"Demo Admin\",\n    \"email\": \"admin@example.com\",\n    \"role\": \"Admin\",\n    \"isActive\": true\n  }\n}"
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "description": "Role: Any logged-in user. Expected 200. Failure: Revoked token: 401. See REMAINING_CODE.md."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"token\", \"\");"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 example",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "url": "{{baseUrl}}/api/v1/auth/logout",
                "description": "Role: Any logged-in user. Expected 200. Failure: Revoked token: 401. See REMAINING_CODE.md."
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"message\": \"Logout successful.\"\n}"
            }
          ]
        }
      ]
    },
